APP_NAME=Bano
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
APP_PORT=8088

# All user-facing API messages (validation, errors, success) are localized.
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=banu
DB_USERNAME=banu
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
DB_PORT_HOST=3307

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

FILESYSTEM_DISK=local
AVATAR_DISK=public
SESSION_MEDIA_DISK=local
HOMEWORK_DISK=local
# Missionary memory photos/videos. Public disk keeps their URLs permanent
# since memories are shown on the external (WordPress) missionary detail.
MEMORY_DISK=public
# Fallback session length (minutes) for the dashboard "hours spent" tile.
DEFAULT_SESSION_DURATION_MINUTES=60
# How long a signed preview URL for local-disk media (tickets, homework,
# session attachments) stays valid before it 404s and must be re-fetched.
MEDIA_SIGNED_URL_TTL_MINUTES=1440

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8088

# Bano-specific
TERMS_REQUIRED_FOR_MISSIONARY=3
DEFAULT_EXAM_PASS_SCORE=70
WORDPRESS_MISSIONARY_API_KEY=change_me

DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=password

# SMS / OTP
# SMS_DRIVER options: log (writes to laravel.log), kavenegar, smsir.
SMS_DRIVER=log
SMS_FROM=
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# sms.ir credentials. Get these from your sms.ir panel.
# - SMS_IR_API_KEY: header X-API-KEY value.
# - SMS_IR_VERIFY_TEMPLATE_ID: pre-registered OTP template; required for /v1/send/verify.
# - SMS_IR_PARAMETER_NAME: must match the variable name in the template (sms.ir default is "Code").
# - SMS_IR_LINE_NUMBER: used only for non-OTP free-form messages via /v1/send/bulk.
SMS_IR_API_KEY=
SMS_IR_VERIFY_TEMPLATE_ID=
SMS_IR_PARAMETER_NAME=Code
SMS_IR_LINE_NUMBER=
SMS_IR_BASE_URL=https://api.sms.ir

OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_TTL_SECONDS=600

# Universal OTP bypass — any user can use this value as their OTP and it
# will succeed. Leave EMPTY in production to disable. Keep set during dev
# / while real sms.ir credentials are pending.
OTP_MASTER_CODE=111111

UID=1000
GID=1000
